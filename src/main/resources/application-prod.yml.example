# Nusxa oling: application-prod.yml.example -> application-prod.yml
# So'ngra CHANGE_ME qiymatlarini real qiymatlar bilan to'ldiring.
# application-prod.yml .gitignore da — commit qilinmaydi.

server:
  port: 8888

spring:
  datasource:
    url: jdbc:postgresql://DB_HOST:5432/mentour_biz
    username: CHANGE_ME
    password: CHANGE_ME
  jpa:
    hibernate:
      ddl-auto: update
    generate-ddl: true
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
        enable_lazy_load_no_trans: true
  servlet:
    multipart:
      max-file-size: 20MB
      max-request-size: 20MB
  mail:
    host: smtp.zoho.com
    port: 587
    username: CHANGE_ME
    password: CHANGE_ME
    properties:
      mail.smtp.auth: true
      mail.smtp.starttls.enable: true

bbb:
  server:
    url: https://BBB_HOST/bigbluebutton/
    secret: CHANGE_ME
  webhook:
    callback-base-url: https://API_HOST

logging:
  level:
    org:
      springframework:
        web:
          cors: debug

app:
  internal-secret: CHANGE_ME
  jwt:
    secret: CHANGE_ME
    accessTokenExpiration: 86400000
    refreshTokenExpiration: 2592000000
  ssh:
    username: CHANGE_ME
    password: CHANGE_ME
    host: CHANGE_ME
    port: 22
  processing-server:
    host: CHANGE_ME
    port: 22
    username: CHANGE_ME
    password: CHANGE_ME
    recordings-base-path: /var/bigbluebutton/published/presentation/
  backend-url: https://API_HOST
  octo:
    secret: CHANGE_ME
    shop-id: CHANGE_ME
  whatsapp:
    token: CHANGE_ME
    phoneNumberId: CHANGE_ME
    verifyToken: CHANGE_ME
  video-server:
    base-url: http://VIDEO_HOST/static/
  file-server:
    base-url: http://FILE_HOST/static/
  telegram:
    bot-token: CHANGE_ME
    bot-username: CHANGE_ME
    alert-bot-token: CHANGE_ME
    alert-chat-id: CHANGE_ME
    alert-thread-id: CHANGE_ME
  ai-service:
    url: http://AI_HOST:8000
    task-result: http://AI_HOST:8000
    webhook-secret: CHANGE_ME
  frontend-url: https://FRONTEND_HOST

springdoc:
  swagger-ui:
    path: /swagger-ui.html
  telegram:
    bot-token: CHANGE_ME

auth:
  users:
    - username: sello-ecom
      password: CHANGE_ME
      role: EXTERNAL_SELLO
    - username: ofb-pay-ecom
      password: CHANGE_ME
      role: EXTERNAL_OFB_PAY

external:
  sello:
    ecom-url: https://ecomm.sello.uz
    ecom-merchant-id: CHANGE_ME
    ecom-username: CHANGE_ME
    ecom-password: CHANGE_ME
    payment-url: CHANGE_ME
  uzum:
    api-url: https://checkout-key.inplat-tech.com
    terminal-id: CHANGE_ME
    api-key: CHANGE_ME
    success-url: https://FRONTEND_HOST
    failure-url: https://FRONTEND_HOST
    session-timeout-secs: 1800
    spic: CHANGE_ME
    package-code: CHANGE_ME
    vat-percent: 0
    tin: CHANGE_ME
    course: 12000
    description: CHANGE_ME
  ofb-pay:
    merchant-id: CHANGE_ME
    salt: CHANGE_ME
    pay-url: https://pay.ofb.uz
    callback-url: https://FRONTEND_HOST
    description: CHANGE_ME
